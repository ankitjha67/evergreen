# Evergreen GitHub App — required environment variables

# Your GitHub App's numeric ID (from app settings page)
GITHUB_APP_ID=

# PEM-encoded private key (paste the key directly, with \n for newlines)
# OR set GITHUB_PRIVATE_KEY_PATH to the .pem file path
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# Webhook secret (set during App creation)
GITHUB_WEBHOOK_SECRET=

# Optional
PORT=3000
LOG_LEVEL=info
SPECS_DIR=specs
