# Evergreen GitHub App — required environment variables

# Your GitHub App's numeric ID (from app settings page)
GITHUB_APP_ID=

# PEM-encoded private key (paste the key directly, with \n for newlines)
# OR set GITHUB_PRIVATE_KEY_PATH to the .pem file path
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# Webhook secret (set during App creation)
GITHUB_WEBHOOK_SECRET=

# Optional
PORT=3000
LOG_LEVEL=info
SPECS_DIR=specs

# --- LLM Provider Configuration (FR-09) ---
# Default provider (anthropic, openai, gemini, ollama, groq, together, fireworks, deepseek, nvidia-nim, mistral, etc.)
# MIGRATION_PROVIDER=anthropic

# Anthropic Claude (default)
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Google Gemini
# GOOGLE_API_KEY=

# Groq
# GROQ_API_KEY=

# Together AI
# TOGETHER_API_KEY=

# Fireworks AI
# FIREWORKS_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# NVIDIA NIM
# NVIDIA_API_KEY=

# Mistral AI
# MISTRAL_API_KEY=

# OpenRouter (200+ models via one key)
# OPENROUTER_API_KEY=

# Local providers (no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1

# Auto-migration (FR-10) — set to "true" to auto-create PRs on webhook
# AUTO_MIGRATE=false
